import requests
import json

# 1. Configuration
USER_AGENT = "mygeoapp.com, contact@mygeoapp.com"  # required by NWS API
LAT, LON = 41.86, -70.93  # Sample coords (Acushnet, MA area)
GRIDPOINT_ENDPOINT = f"https://api.weather.gov/points/{LAT},{LON}"

def fetch_grid_metadata():
    resp = requests.get(GRIDPOINT_ENDPOINT, headers={"User-Agent": USER_AGENT})
    resp.raise_for_status()
    data = resp.json()
    return data["properties"]["gridId"], data["properties"]["gridX"], data["properties"]["gridY"]

def fetch_observation(grid_id, gridx, gridy):
    url = f"https://api.weather.gov/gridpoints/{grid_id}/{gridx},{gridy}/observations"
    resp = requests.get(url, headers={"User-Agent": USER_AGENT})
    resp.raise_for_status()
    return resp.json()

def build_geojson(observations):
    features = []
    for obs in observations.get("features", []):
        props = obs["properties"]
        geom = obs["geometry"]

        wind_spd = props.get("windSpeed", {}).get("value")
        wind_dir = props.get("windDirection", {}).get("value")
        if wind_spd is None or wind_dir is None:
            continue

        feature = {
            "type": "Feature",
            "geometry": geom,
            "properties": {
                "windSpeed_mps": wind_spd,
                "windDirection_deg": wind_dir,
                "timestamp": props.get("timestamp")
            }
        }
        features.append(feature)

    return {
        "type": "FeatureCollection",
        "features": features
    }

def main():
    grid_id, gx, gy = fetch_grid_metadata()
    obs = fetch_observation(grid_id, gx, gy)
    geojson = build_geojson(obs)
    print(json.dumps(geojson, indent=2))

if __name__ == "__main__":
    main()
